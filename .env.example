# ─── Studio ───────────────────────────────────────────────────────────────────
# Base URL of the GN-Apex backend. The Studio talks to the authoring API at
# `/workspace/:projectId/*` and mints preview tokens at
# `/projects/:projectId/workspace-template/preview-token`.
NEXT_PUBLIC_API_URL=http://localhost:3001

# The portal the preview iframe loads. This is the *client site*, not the
# backend. Leave it empty when the portal is served from the same origin as the
# Studio (behind one reverse proxy); set it when the portal has its own host.
# Comma-separate several to allow more than one; anything else is refused by the
# `/preview` proxy's allow-list.
# NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:3000

# Set to `1` to route the iframe through the Studio's same-origin `/preview`
# proxy instead of framing the portal directly. Only needed when the portal
# sends `X-Frame-Options` or `frame-ancestors` that block a cross-origin frame.
# The proxy injects <base href="<portal-origin>/"> so the portal's assets still
# resolve to the portal, not the Studio.
# NEXT_PUBLIC_PREVIEW_PROXY=1
